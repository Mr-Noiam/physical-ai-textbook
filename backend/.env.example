# Database Configuration
DATABASE_URL=postgresql://your_user:your_password@your-host.neon.tech/neondb?sslmode=require

# Qdrant Vector Database
QDRANT_COLLECTION_NAME=physical_ai_textbook
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io

# OpenAI API (OPTIMIZED FOR SPEED)
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL=gpt-4o-mini  # Faster & cheaper than gpt-4 (3-5x speed improvement)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Authentication (placeholder for Phase 6)
AUTH_SECRET=change-this-to-a-secure-random-string-in-production
AUTH_URL=http://localhost:3000

# Backend Configuration
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://parep.github.io

# Environment
ENVIRONMENT=development
