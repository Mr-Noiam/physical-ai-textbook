# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Neon Postgres Database
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Qdrant Vector Database
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=physical_ai_textbook

# better-auth Configuration
AUTH_SECRET=your_auth_secret_key_minimum_32_characters
AUTH_URL=http://localhost:3000

# Backend API Configuration
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,https://your-github-pages-url.github.io

# Environment
NODE_ENV=development
PYTHON_ENV=development

# Optional: Railway/Render Deployment
RAILWAY_TOKEN=your_railway_token_here
